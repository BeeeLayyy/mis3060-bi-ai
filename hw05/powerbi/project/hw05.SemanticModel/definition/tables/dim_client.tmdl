				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_client.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"client_id", Int64.Type}, {"first_name", type text}, {"last_name", type text}, {"age", Int64.Type}, {"city", type text}, {"state", type text}, {"zip_code", type text}, {"risk_profile", type text}, {"client_tier", type text}, {"primary_account_type", type text}, {"initial_aum", type number}, {"client_since", type date}, {"advisor_id", Int64.Type}, {"is_active", type logical}}, "en-US")
