	partition fact_portfolio_snapshot = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_portfolio_snapshot.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"snapshot_id", Int64.Type}, {"client_id", Int64.Type}, {"advisor_id", Int64.Type}, {"benchmark_id", Int64.Type}, {"snapshot_date", type date}, {"year", Int64.Type}, {"month", Int64.Type}, {"aum", type number}, {"return_ytd", type number}, {"benchmark_return_ytd", type number}, {"active_alpha_ytd", type number}, {"cash_pct", type number}, {"account_type", type text}, {"is_return_suspect", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
