	partition fact_fees = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_fees.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"fee_id", Int64.Type}, {"client_id", Int64.Type}, {"advisor_id", Int64.Type}, {"fee_date", type date}, {"fee_type", type text}, {"aum_basis", type number}, {"bps_charged", type number}, {"amount", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
