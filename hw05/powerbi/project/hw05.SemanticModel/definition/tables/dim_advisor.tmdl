	partition dim_advisor = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_advisor.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"advisor_id", Int64.Type}, {"first_name", type text}, {"last_name", type text}, {"region", type text}, {"years_experience", Int64.Type}, {"aum_target_mm", type number}, {"certifications", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
