	partition dim_security = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_security.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"security_id", Int64.Type}, {"ticker", type text}, {"name", type text}, {"asset_class", type text}, {"sector", type text}, {"benchmark_id", Int64.Type}, {"is_etf", type logical}, {"expense_ratio_bps", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
