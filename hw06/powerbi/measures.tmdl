createOrReplace

	table _Measures

		measure 'Total Fees' = SUM ( fact_fees[amount] )
			formatString: \$#,0.00
			displayFolder: Base

		measure 'Net Flows' =
				CALCULATE ( SUM ( fact_transactions[amount] ), fact_transactions[txn_type] = "Deposit" )
				    - CALCULATE ( SUM ( fact_transactions[amount] ), fact_transactions[txn_type] = "Withdrawal" )
			formatString: \$#,0.00
			displayFolder: Base

		measure 'AUM (naive SUM)' = SUM ( fact_portfolio_snapshot[aum] )
			formatString: \$#,0.00
			displayFolder: Trap

		measure 'Ending AUM' =
				CALCULATE (
				    SUM ( fact_portfolio_snapshot[aum] ),
				    LASTNONBLANK ( dim_date[date], CALCULATE ( COUNTROWS ( fact_portfolio_snapshot ) ) )
				)
			formatString: \$#,0.00
			displayFolder: Library

		measure 'Ending Clients' =
				CALCULATE (
				    DISTINCTCOUNT ( fact_portfolio_snapshot[client_id] ),
				    LASTNONBLANK ( dim_date[date], CALCULATE ( COUNTROWS ( fact_portfolio_snapshot ) ) )
				)
			formatString: #,0
			displayFolder: Library

		measure 'Avg AUM per Client' = DIVIDE ( [Ending AUM], [Ending Clients] )
			formatString: \$#,0.00
			displayFolder: Library

		measure 'Ending AUM LY' = CALCULATE ( [Ending AUM], SAMEPERIODLASTYEAR ( dim_date[date] ) )
			formatString: \$#,0.00
			displayFolder: Library

		measure 'AUM YoY %' = DIVIDE ( [Ending AUM] - [Ending AUM LY], [Ending AUM LY] )
			formatString: 0.00%
			displayFolder: Library

		measure 'Ending AUM PM' = CALCULATE ( [Ending AUM], DATEADD ( dim_date[date], -1, MONTH ) )
			formatString: \$#,0.00
			displayFolder: Library

		measure 'AUM MoM %' = DIVIDE ( [Ending AUM] - [Ending AUM PM], [Ending AUM PM] )
			formatString: 0.00%
			displayFolder: Library

		measure 'Avg Monthly AUM' =
				DIVIDE (
				    SUM ( fact_portfolio_snapshot[aum] ),
				    DISTINCTCOUNT ( fact_portfolio_snapshot[snapshot_date] )
				)
			formatString: \$#,0.00
			displayFolder: Library

		measure 'Fee Yield (bps)' = DIVIDE ( [Total Fees] * 12 * 10000, SUM ( fact_portfolio_snapshot[aum] ) )
			formatString: 0.00
			displayFolder: Library

		measure 'Organic Growth Rate' = DIVIDE ( [Net Flows], [Ending AUM LY] )
			formatString: 0.00%
			displayFolder: Library

		measure 'AUM-Weighted Alpha' =
				VAR LastSnapshot = LASTNONBLANK ( dim_date[date], CALCULATE ( COUNTROWS ( fact_portfolio_snapshot ) ) )
				RETURN
				    CALCULATE (
				        DIVIDE (
				            SUMX ( fact_portfolio_snapshot, fact_portfolio_snapshot[aum] * fact_portfolio_snapshot[active_alpha_ytd] ),
				            SUM ( fact_portfolio_snapshot[aum] )
				        ),
				        LastSnapshot,
				        fact_portfolio_snapshot[is_return_suspect] <> 1
				    )
			formatString: 0.00%
			displayFolder: Library

		measure 'Alpha Signal' =
				VAR Alpha = [AUM-Weighted Alpha]
				RETURN
				    IF (
				        ISBLANK ( Alpha ),
				        BLANK (),
				        SWITCH ( TRUE (), Alpha >= 0.02, "Outperforming", Alpha <= -0.02, "Lagging", "In line" )
				    )
			displayFolder: Library

		measure 'Top 10 Client Share' =
				VAR LastSnapshot = LASTNONBLANK ( dim_date[date], CALCULATE ( COUNTROWS ( fact_portfolio_snapshot ) ) )
				VAR ClientAUM =
				    ADDCOLUMNS (
				        VALUES ( dim_client[client_id] ),
				        "@aum", CALCULATE ( SUM ( fact_portfolio_snapshot[aum] ), LastSnapshot )
				    )
				VAR Top10 = TOPN ( 10, ClientAUM, [@aum], DESC )
				RETURN
				    DIVIDE ( SUMX ( Top10, [@aum] ), [Ending AUM] )
			formatString: 0.00%
			displayFolder: Library

		column Value
			dataType: string
			isHidden
			summarizeBy: none
			isNameInferred
			sourceColumn: [Value]

		partition _Measures = calculated
			mode: import
			source = { "" }
